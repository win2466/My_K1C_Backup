# =============================================================================
# Creality K1C - Klipper Printer Configuration
# REV 2026-10-25 (v13.1) - fixes "EOL while scanning string literal" halt
#
# Changes from v13:
#   * START_PRINT: the _K1C_SET_CHAMBER_FAN call is now wrapped in a
#     multi-line {% if %}/{% else %} instead of an inline {% if %} on the
#     same line as an interpolation. Prevents any edge case where the
#     inline conditional gets parsed as part of the string.
#   * All other { ... } expressions already single-line (verified v13).
#
# Changes from v12 (carried forward):
#   * M141/M191 moved out of printer.cfg into k1c_chamber_overrides.cfg.
#   * _K1C_SET_CHAMBER_FAN added for Orca FILAMENT_TYPE-driven chamber fan.
#   * START_PRINT: fresh `default` mesh re-applied after fallback G28.
#   * START_PRINT: duplicate ZOFFSET_RESTORE removed.
#   * homing_override: prefers `default` over `k1c_mesh` if both exist.
#   * END_PRINT: calls ZOFFSET_UNSUPPRESS.
#   * All v12 fixes retained (inline CLEAR_NOZZLE_QUICK, TMC run_current 1.1 A,
#     g28_ext_temp 180).
#
# IMPORTANT: the SAVE_CONFIG block at the bottom of this file was copied from
# a pre-2026-10-25 snapshot. After uploading, run:
#   G28
#   G29
#   CXSAVE_CONFIG
# to rebuild the mesh with the actual current bed state. Or copy your current
# #*# SAVE_CONFIG block from the on-disk printer.cfg into this file before
# uploading.
# =============================================================================

[include k1c_compat.cfg]
[include custom_purge.cfg]
[include zoffset-guppy.cfg]
[include k1c_chamber_overrides.cfg]

# Optional skew calibration - uncomment if skew_calibration_macros.cfg exists
# [include skew_calibration_macros.cfg]

[custom_macro]
default_bed_temp: 50
default_extruder_temp: 240
g28_ext_temp: 180

[mcu]
serial: /dev/ttyS7
baud: 230400
restart_method: command

[mcu nozzle_mcu]
serial: /dev/ttyS1
baud: 230400
restart_method: command
